{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:geelark-ia:contract:worker-module-inventory:1.0.0",
  "title": "GeeLark-IA Worker module inventory report v1",
  "description": "Worker declaration accepted only from active nodes. Master-generated checked_at/source are not part of this input payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "modules": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module_id",
          "state"
        ],
        "properties": {
          "module_id": {
            "type": "string",
            "enum": [
              "agent-guard",
              "agent-supervisor",
              "agent-transport",
              "android-engine",
              "task-journal"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "operational",
              "degraded",
              "not-installed",
              "unknown"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z0-9_]{1,64}$"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "module_id": {
                "const": "agent-guard"
              }
            },
            "required": [
              "module_id"
            ]
          },
          "maxContains": 1,
          "description": "At most one entry may declare module_id agent-guard.",
          "minContains": 0
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "module_id": {
                "const": "agent-supervisor"
              }
            },
            "required": [
              "module_id"
            ]
          },
          "maxContains": 1,
          "description": "At most one entry may declare module_id agent-supervisor.",
          "minContains": 0
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "module_id": {
                "const": "agent-transport"
              }
            },
            "required": [
              "module_id"
            ]
          },
          "maxContains": 1,
          "description": "At most one entry may declare module_id agent-transport.",
          "minContains": 0
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "module_id": {
                "const": "android-engine"
              }
            },
            "required": [
              "module_id"
            ]
          },
          "maxContains": 1,
          "description": "At most one entry may declare module_id android-engine.",
          "minContains": 0
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "module_id": {
                "const": "task-journal"
              }
            },
            "required": [
              "module_id"
            ]
          },
          "maxContains": 1,
          "description": "At most one entry may declare module_id task-journal.",
          "minContains": 0
        }
      ]
    }
  }
}
